import sqlite3
from contextlib import contextmanager
from pathlib import Path
from typing import Iterator

DB_PATH = Path(__file__).resolve().parent.parent / "data" / "attendance.db"

SCHEMA = """
CREATE TABLE IF NOT EXISTS students (
    student_id            INTEGER PRIMARY KEY,           -- internal id, never changes
    university_student_id TEXT NOT NULL UNIQUE,          -- the university's own id/roll number
    name                  TEXT NOT NULL,
    section               TEXT NOT NULL,
    active                INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0, 1))
);

-- One student can have several credentials over time (lost card -> revoke + reissue).
CREATE TABLE IF NOT EXISTS credentials (
    credential_id INTEGER PRIMARY KEY AUTOINCREMENT,
    student_id    INTEGER NOT NULL REFERENCES students(student_id),
    token         TEXT NOT NULL UNIQUE,
    active        INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0, 1)),
    issued_at     TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),
    revoked_at    TEXT
);

-- Scanner devices. Only a hash of the device key is stored.
CREATE TABLE IF NOT EXISTS devices (
    device_id  TEXT PRIMARY KEY,
    label      TEXT NOT NULL,
    key_hash   TEXT NOT NULL,
    active     INTEGER NOT NULL DEFAULT 1 CHECK (active IN (0, 1)),
    created_at TEXT NOT NULL DEFAULT (datetime('now', 'localtime'))
);

CREATE TABLE IF NOT EXISTS class_sessions (
    class_id     INTEGER PRIMARY KEY AUTOINCREMENT,
    subject_code TEXT NOT NULL,
    subject      TEXT NOT NULL,
    section      TEXT NOT NULL,
    session_date TEXT NOT NULL,          -- YYYY-MM-DD
    start_time   TEXT NOT NULL,          -- HH:MM:SS
    end_time     TEXT NOT NULL,          -- HH:MM:SS (window closes here)
    finalized    INTEGER NOT NULL DEFAULT 0,
    CHECK (start_time < end_time)
);

CREATE TABLE IF NOT EXISTS attendance (
    attendance_id INTEGER PRIMARY KEY AUTOINCREMENT,
    student_id    INTEGER NOT NULL REFERENCES students(student_id),
    class_id      INTEGER NOT NULL REFERENCES class_sessions(class_id),
    credential_id INTEGER REFERENCES credentials(credential_id),
    device_id     TEXT REFERENCES devices(device_id),
    scan_time     TEXT,                  -- NULL unless created by a scan
    status        TEXT NOT NULL CHECK (status IN ('PRESENT', 'ABSENT')),
    source        TEXT NOT NULL CHECK (source IN ('scanner', 'system', 'staff')),
    UNIQUE (student_id, class_id)        -- one record per student per class (the class has the date)
);

-- Every scan attempt that reached the server with valid device credentials.
CREATE TABLE IF NOT EXISTS scan_log (
    id        INTEGER PRIMARY KEY AUTOINCREMENT,
    ts        TEXT NOT NULL,
    device_id TEXT NOT NULL,
    token     TEXT NOT NULL,
    result    TEXT NOT NULL
);

-- Every change to attendance, plus security-relevant events.
CREATE TABLE IF NOT EXISTS audit_log (
    id         INTEGER PRIMARY KEY AUTOINCREMENT,
    ts         TEXT NOT NULL DEFAULT (datetime('now', 'localtime')),
    actor      TEXT NOT NULL,            -- device:<id>, system, admin, staff:<name>
    action     TEXT NOT NULL,
    student_id INTEGER,
    class_id   INTEGER,
    old_status TEXT,
    new_status TEXT,
    reason     TEXT
);
"""


def get_connection() -> sqlite3.Connection:
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=5)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    conn.execute("PRAGMA journal_mode = WAL")
    return conn


@contextmanager
def db() -> Iterator[sqlite3.Connection]:
    """One connection per request; commit on success, roll back on error."""
    conn = get_connection()
    try:
        yield conn
        conn.commit()
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()


def init_db() -> None:
    with db() as conn:
        conn.executescript(SCHEMA)



@dataclass
class SyncError:
    record: str   # e.g. "student university_student_id=..." or "class_id=..."
    message: str


class StudentInfoSystemAdapter(Protocol):
    def export_attendance(self, class_id: int) -> list[SyncError]:
        """Send one finalized session's attendance out. Returns per-record errors."""
        ...

    def sync_students(self) -> list[SyncError]:
        """Pull the official student list, matching on university_student_id."""
        ...

    def sync_classes(self) -> list[SyncError]:
        """Pull the official subjects/timetable, matching on subject_code."""
        ...

    def reconcile(self, class_id: int) -> list[SyncError]:
        """Compare local records with the external system and report differences."""
        ...
